<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>⟡ HJ SHOP ⟡ 電商商店</title>
    <style>
        /* 基礎設定 */
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: sans-serif; scroll-behavior: smooth; }
        body { background-color: #fcfbfa; color: #333; padding-bottom: 60px; }
        
        /* 導覽列 */
        header { background: #fff; border-bottom: 1px solid #eee; padding: 15px; position: sticky; top: 0; z-index: 100; text-align: center; }
        .logo { font-size: 24px; font-weight: bold; letter-spacing: 2px; margin-bottom: 10px; color: #4a4a4a; }
        .nav-menu { display: flex; justify-content: center; list-style: none; gap: 15px; font-size: 14px; }
        .nav-menu a { text-decoration: none; color: #666; font-weight: 500; }
        .nav-menu a:hover { color: #bfa37a; }

        /* 主內容區 */
        main { max-width: 1200px; margin: 30px auto; padding: 0 20px; }
        .category-section { margin-bottom: 50px; scroll-margin-top: 140px; /* 防止導覽列擋住標題 */ }
        .section-title { font-size: 20px; margin-bottom: 20px; color: #4a4a4a; border-left: 4px solid #bfa37a; padding-left: 10px; }
        
        /* 商品網格 */
        .products-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
        .loading-text { text-align: center; font-size: 16px; color: #888; padding: 40px 0; }
        .empty-text { font-size: 14px; color: #999; grid-column: 1 / -1; padding: 20px 0; }

        /* 商品卡片 */
        .product-card { background: #fff; border: 1px solid #eee; border-radius: 8px; overflow: hidden; cursor: pointer; transition: transform 0.2s; display: flex; flex-direction: column; }
        .product-card:hover { transform: translateY(-3px); box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
        .prod-img-box { width: 100%; padding-top: 100%; position: relative; background: #f5f5f5; }
        .prod-img-box img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; }
        .prod-info { padding: 15px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; }
        .prod-name { font-size: 14px; margin-bottom: 10px; height: 40px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
        .prod-price { font-size: 16px; font-weight: bold; color: #d15b5b; }

        /* 購物車按鈕 */
        .cart-btn { position: fixed; bottom: 20px; right: 20px; background: #bfa37a; color: #fff; border: none; padding: 15px 20px; border-radius: 50px; font-size: 16px; cursor: pointer; box-shadow: 0 4px 10px rgba(0,0,0,0.2); z-index: 99; }

        /* 彈出視窗 */
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; justify-content: center; align-items: center; padding: 20px; }
        .modal-content { background: #fff; padding: 25px; border-radius: 12px; max-width: 500px; width: 100%; position: relative; max-height: 90vh; overflow-y: auto; }
        .close-btn { position: absolute; top: 15px; right: 15px; font-size: 24px; cursor: pointer; background: none; border: none; color: #999; }
        .detail-img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 8px; margin-bottom: 15px; background: #f5f5f5; }
        .detail-name { font-size: 18px; font-weight: bold; margin-bottom: 10px; }
        .detail-price { font-size: 20px; color: #d15b5b; font-weight: bold; margin-bottom: 15px; }
        .qty-box { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; }
        .qty-box input { width: 60px; padding: 5px; text-align: center; }
        .add-to-cart-btn { width: 100%; background: #333; color: #fff; border: none; padding: 12px; border-radius: 6px; font-size: 16px; cursor: pointer; }

        /* 購物車明細 */
        .cart-item { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #eee; font-size: 14px; }
        .cart-total { text-align: right; font-size: 18px; font-weight: bold; margin: 20px 0; color: #d15b5b; }
        .order-form { display: flex; flex-direction: column; gap: 10px; margin-top: 15px; }
        .order-form input { padding: 10px; border: 1px solid #ddd; border-radius: 4px; }
        .submit-btn { background: #bfa37a; color: #fff; border: none; padding: 12px; border-radius: 6px; font-size: 16px; cursor: pointer; margin-top: 10px; }

        @media (max-width: 768px) { .products-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; } }
    </style>
</head>
<body>

    <header>
        <div class="logo">⟡ HJ SHOP ⟡</div>
        <ul class="nav-menu">
            <li><a href="#sec-all">全部商品</a></li>
            <li><a href="#sec-3c">3C配件</a></li>
            <li><a href="#sec-case">手機殼</a></li>
            <li><a href="#sec-clothes">女裝</a></li>
        </ul>
    </header>

    <main id="main-content">
        <div class="loading-text" id="loading-status">商店開張中，正在從雲端載入商品...</div>

        <!-- 3C配件分區 -->
        <section class="category-section" id="sec-3c">
            <h2 class="section-title">｜3C配件</h2>
            <div class="products-grid" id="grid-3c"><p class="empty-text">尚無商品</p></div>
        </section>

        <!-- 手機殼分區 -->
        <section class="category-section" id="sec-case">
            <h2 class="section-title">｜殼の家 (手機殼)</h2>
            <div class="products-grid" id="grid-case"><p class="empty-text">尚無商品</p></div>
        </section>

        <!-- 女裝分區 -->
        <section class="category-section" id="sec-clothes">
            <h2 class="section-title">｜變美專區 (女裝/服飾)</h2>
            <div class="products-grid" id="grid-clothes"><p class="empty-text">尚無商品</p></div>
        </section>

        <!-- 其他未分類分區 -->
        <section class="category-section" id="sec-all">
            <h2 class="section-title">｜精選其他商品</h2>
            <div class="products-grid" id="grid-other"><p class="empty-text">尚無商品</p></div>
        </section>
    </main>

    <button class="cart-btn" onclick="openCartModal()">🛒 購物車 (<span id="cart-count">0</span>)</button>

    <!-- 彈窗 1：商品詳情 -->
    <div class="modal" id="product-modal">
        <div class="modal-content">
            <button class="close-btn" onclick="closeModal('product-modal')">×</button>
            <img class="detail-img" id="modal-img" src="" alt="">
            <div class="detail-name" id="modal-name"></div>
            <div class="detail-price" id="modal-price"></div>
            <div class="qty-box">
                <label>數量：</label>
                <input type="number" id="modal-qty" value="1" min="1">
            </div>
            <button class="add-to-cart-btn" onclick="addToCart()">加入購物車</button>
        </div>
    </div>

    <!-- 彈窗 2：購物車明細 -->
    <div class="modal" id="cart-modal">
        <div class="modal-content">
            <button class="close-btn" onclick="closeModal('cart-modal')">×</button>
            <h3>購物車明細</h3>
            <div id="cart-items-list" style="margin-top: 15px;"></div>
            <div class="cart-total">總金額：NT$ <span id="cart-total-price">0</span></div>
            <hr style="border: 0; border-top: 1px solid #ddd; margin: 20px 0;">
            <h3>填寫下單資料</h3>
            <iframe name="hidden_iframe" id="hidden_iframe" style="display:none;" onload="if(submitted){handleOrderSuccess();}"></iframe>
            <form id="orderForm" target="hidden_iframe" method="POST">
                <div class="order-form">
                    <input type="text" id="buyer-name" placeholder="收件人姓名" required>
                    <input type="tel" id="buyer-phone" placeholder="聯絡電話" required>
                    <input type="text" id="buyer-address" placeholder="收件地址 (或7-11店名)" required>
                    <input type="hidden" id="hidden-name"><input type="hidden" id="hidden-phone"><input type="hidden" id="hidden-address"><input type="hidden" id="hidden-details">
                    <button type="submit" class="submit-btn" id="submit-order-btn" onclick="prepareSubmit()">確認送出訂單</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const SPREADSHEET_ID = "1Fm9M71u2mjxCj51xYBGyMwGBy7taoxPWMnblrIhSoDY";
        const JSON_URL = `https://google.com{SPREADSHEET_ID}/gviz/tq?tqx=out:json`;

        const GOOGLE_FORM_URL = "https://google.com"; // 填寫收件人資料的表單
        const ENTRY_NAME = "entry.838700288"; const ENTRY_PHONE = "entry.1964084771"; const ENTRY_ADDRESS = "entry.1140656410"; const ENTRY_DETAILS = "entry.671396062"; 

        let myProducts = []; let cart = []; let currentSelectedProduct = null; let submitted = false;

        // 讀取 Excel 並自動做分類
        fetch(JSON_URL)
            .then(res => res.text())
            .then(data => {
                const temp = data.substring(47, data.length - 2);
                const json = JSON.parse(temp);
                const rows = json.table.rows;
                
                document.getElementById('loading-status').style.display = 'none';
                if(!rows || rows.length === 0) return;

                // 先清空「尚無商品」的提示字
                document.getElementById('grid-3c').innerHTML = '';
                document.getElementById('grid-case').innerHTML = '';
                document.getElementById('grid-clothes').innerHTML = '';
                document.getElementById('grid-other').innerHTML = '';

                rows.forEach((row, index) => {
                    // 對應欄位：B名稱、C價格、D分類、E照片
                    const name = row.c[1] ? row.c[1].v : "未命名商品";
                    const price = row.c[2] ? parseInt(row.c[2].v) : 0;
                    const category = row.c[3] ? row.c[3].v.toString().trim() : "其他";
                    let rawImg = row.c[4] ? row.c[4].v : "";
                    
                    let imgUrl = "https://placeholder.com";
